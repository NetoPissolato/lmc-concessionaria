# Backend - Variáveis de Ambiente
# Copie este arquivo para .env.production e preencha os valores reais
# NÃO commite o arquivo .env.production no git!

# ─── Banco de Dados ────────────────────────────────────────────────────────────
POSTGRES_DB=lmc_veiculos
POSTGRES_USER=lmc_user
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_FORTE

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT / Segurança ───────────────────────────────────────────────────────────
SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_64_CHARS_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Banco (URL completa) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lmc_user:TROQUE_ESTA_SENHA_FORTE@postgres:5432/lmc_veiculos

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://SEU_DOMINIO_AQUI
