# Backend - Variáveis de Ambiente
# Copie este arquivo para .env.production e preencha os valores reais
# NÃO commite o arquivo .env.production no git!
#
# Em produção (docker-compose.prod.yml) DATABASE_URL e REDIS_URL são montados
# pelo compose a partir de DB_PASSWORD e REDIS_PASSWORD do arquivo /opt/lmc/.env.
# Os valores abaixo só valem para rodar o backend fora do Docker.

# ─── Banco / Redis (só fora do Docker) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://lmc_user:TROQUE_A_SENHA@localhost:5432/lmc_veiculos
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Segurança ───────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GERE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# Domínios que podem chamar a API (painel e site), separados por vírgula
ALLOWED_ORIGINS=https://painel.seudominio.com,https://site.seudominio.com
FRONTEND_URL=https://painel.seudominio.com
